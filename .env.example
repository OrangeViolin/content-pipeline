# ============================================
# Content Pipeline - Environment Variables
# ============================================
# Copy this file to local/.env and fill in your values.
# The local/ directory is git-ignored and will NOT be uploaded.

# --- WeChat Official Account API (optional) ---
# Used for pushing drafts directly via API (L0 mode)
# Get from: https://mp.weixin.qq.com
WECHAT_APPID=
WECHAT_APPSECRET=

# --- TTS Voice Generation (IndexTTS2, local) ---
# Install: https://github.com/index-tts/index-tts
INDEXTTS_DIR=~/index-tts
VOICE_REF=/path/to/your/voice_ref.wav

# --- Markdown Formatter (optional) ---
# Path to md-formatter tool for WeChat article formatting
MD_FORMATTER_DIR=

# --- Remotion Brand Video (optional) ---
# Path to Remotion project for brand intro/outro generation
REMOTION_DIR=
