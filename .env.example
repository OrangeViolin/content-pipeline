# WeChat Official Account API credentials
WECHAT_APPID=
WECHAT_APPSECRET=

# Fish Audio TTS API key (get from https://fish.audio)
FISH_API_KEY=

# Path to md-formatter tool (排版工具)
# Example: /path/to/md-formatter
MD_FORMATTER_DIR=

# Path to baoyu-post-to-wechat skill (公众号发布工具)
# Example: /path/to/baoyu-skills/skills/baoyu-post-to-wechat
BAOYU_WECHAT_SKILL_DIR=

# Path to md-to-wechat script (Markdown → WeChat HTML converter)
# Example: /path/to/baoyu-post-to-wechat/scripts/md-to-wechat.ts
MD_TO_WECHAT_SCRIPT=

# Path to Remotion brand video project (optional)
# Example: /path/to/remotion-01fish
REMOTION_DIR=
